    "js-template-literals": "\n        <span class=\"eyebrow\">Strings</span>\n        <h3>Template literals</h3>\n        <p>Template literals are a way to create strings in JavaScript using backticks (`) instead of single quotes (' ') or double quotes (\" \").</p><p>They make it easier to:</p><p>1. Insert variables into strings using ${}.</p><p>2. Write strings across multiple lines.</p><p>3. Perform expressions directly inside strings.</p>\n        <pre><code><span class=\"c-kw\">const</span> name = 'Ram';\n<span class=\"c-kw\">const</span> msg = `Hello ${name}, you have ${<span class=\"c-num\">3</span> + <span class=\"c-num\">2</span>} <span class=\"c-kw\">new</span> messages<span class=\"c-str\">`;\n\nconst html = `</span>\n  &lt;div <span class=\"c-kw\">class</span>=\"card\"&gt;\n    &lt;h2&gt;${name}&lt;/h2&gt;\n  &lt;/div&gt;`;</code></pre>\n        <p><b>Tagged templates</b> pass the string parts and values to a function first, e.g. <code>html`&lt;p&gt;${x}&lt;/p&gt;`</code> in some libraries, to escape or process values.</p>\n      ",
    "js-promise-combinators": "\n        <span class=\"eyebrow\">Async</span>\n        <h3>Promise.all, allSettled, race &amp; any</h3><div>Promise.all() — Returns results when all Promises succeed; rejects if any Promise fails.</div><div><br></div><div>Promise.allSettled() — Waits for all Promises to finish and returns the status and result of each Promise, whether successful or failed.</div><div><br></div><div>Promise.race() — Returns the result of the first Promise to settle, whether it succeeds or fails.</div><div><br></div><div>Promise.any() — Returns the result of the first Promise to succeed; rejects with an AggregateError if all Promises fail.</div>\n        <div class=\"table-wrap\">\n          <table><thead><tr><th></th><th></th><th><br></th></tr></thead><tbody><tr><td></td><td></td><td><br></td></tr>\n              <tr><td><br></td><td><br></td><td><br></td></tr>\n            </tbody>\n          </table>\n        </div>\n        <pre><code><span class=\"c-kw\">const</span> [users, products] = <span class=\"c-kw\">await</span> <span class=\"c-fn\">Promse</span>.<span class=\"c-fn\">all</span>([\n  <span class=\"c-fn\">fetch</span>('/api/users<span class=\"c-str\">').then(r =&gt; r.json()),\n  fetch('</span>/api/products<span class=\"c-str\">').then(r =&gt; r.json())\n]);\n\nconst results = await Promise.allSettled([saveA(), saveB()]);\nconst failed = results.filter(r =&gt; r.status === '</span>rejected<span class=\"c-str\">');\n\nconst report = await Promise.race([\n  fetch('</span>/api/report<span class=\"c-str\">'),\n  new Promise((_, reject) =&gt; setTimeout(() =&gt; reject(new Error('</span>Timeout')), <span class=\"c-num\">5000</span>))\n]);</code></pre>\n        <div class=\"usecase\"><b>RxJS equivalents:</b> <code>Promise.all</code> is like <a href=\"#forkjoin\">forkJoin</a>; <code>Promise.race</code> is like <a href=\"#race\">race</a>.</div>\n      ",
    "angular-cli": "\n        <span class=\"eyebrow\">Tooling</span>\n        <h3>What is Angular CLI?</h3>\n        <p>Angular CLI is a command-line tool used to create, run, build, and manage Angular applications using\n          commands, instead of writing everything manually.</p>\n        <ul>\n          <li>Automates development tasks like generating components, services, and modules, and building the\n            project.</li>\n        </ul>\n      ",
    "ts-any-unknown-never": "\n        <span class=\"eyebrow\">Types</span>\n        <h3>What is the difference between any, unknown and never?</h3><div>All three are TypeScript types, but they serve different purposes.</div><div><br></div><div>any: It disables TypeScript type checking. We can assign any value and perform operations without type errors.</div><div><br></div><div>unknown: It also accepts any type of value, but unlike any, we must check the data type before performing operations. It is safer than any.</div><div><br></div><div>never: It represents a value that can never occur. We use it for functions that never return normally, such as functions that always throw errors, and for exhaustive checking to identify missing cases in switch statements.</div>\n        <pre><br></pre>\n      ",
    "ts-type-inference": "\n        <span class=\"eyebrow\">Types</span>\n        <h3>What is the diffrence between&nbsp; type and interface&nbsp;</h3>\n        <p>Both type and interface are used to define the structure of objects in TypeScript.</p><p>interface: Mainly used to define object structures.</p><p>type: Used to define object structures, unions, intersections, tuples, and primitive types.</p><p>interface User {</p><p>&nbsp; id: number;</p><p>&nbsp; name: string;</p><p>}</p><p>type Product = {</p><p>&nbsp; id: number;</p><p>&nbsp; price: number;</p><p>};</p><p>type Status = 'success' | 'error' | 'loading';</p>\n      ",
    "ts-interface-vs-type": "\n        <span class=\"eyebrow\">Types</span>\n        <h3>What is the difference between Union and Intersection types in TypeScript?</h3>\n        <p>&nbsp;In TypeScript, Union and Intersection types are used to combine multiple types.</p>\n        <ul>\n          <li>Union (|): Allows a variable to accept one of multiple specified types. For example, a variable can accept either a string or a number.</li>\n          <li>Intersection (&amp;): Combines multiple types into a single type. The resulting object must satisfy all the properties of the combined types.</li></ul><pre><code><font color=\"#7fb0ff\">let data: string | number;</font><br>data = 'Aniket';<br>data = 100;\n\n<font color=\"#7fb0ff\">type User = {<br>  name: string;<br>};<br><br>type Employee = {<br>  salary: number;<br>};<br><br>type EmployeeDetails = User &amp; Employee;<br>const emp: EmployeeDetails = {<br>  name: 'Aniket',<br>  salary: 50000<br>};</font></code></pre>\n      "
  }
